### Total Sales & Profit
SELECT SUM(Sales) AS Total_Sales,SUM(Profit) AS Total_Profit FROM ecommerce;

# Business question:
# What is the overall revenue and profit generated by the e-commerce business?

### Category-wise Sales & Profit
SELECT Category,SUM(Sales) AS Total_Sales,SUM(Profit) AS Total_Profit
FROM ecommerce
GROUP BY Category
ORDER BY Total_Sales DESC;

# What this does
# SUM(Sales) → adds sales for each category
# SUM(Profit) → adds profit for each category
# GROUP BY Category → creates one result for each category
# ORDER BY Total_Sales DESC → highest sales category appears first


### Top 10 Products by Sales

SELECT Product, SUM(Sales) AS Total_Sales
FROM ecommerce
GROUP BY Product
ORDER BY Total_Sales DESC
LIMIT 10;

# Why?
# GROUP BY Product → combines all orders for each product
# SUM(Sales) → calculates total sales for each product
# ORDER BY ... DESC → highest sales first
# LIMIT 10 → shows only the top 10

